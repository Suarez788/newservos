k\",\"20\",{\"rel\":\"icon\",\"href\":\"https://static-beta.curseforge.com/images/favicon.ico\"}],[\"$\",\"$L7e\",\"21\",{}]]\n38:null\n7f:I[92997,[\"$4\",\"$5\",\"$6\",\"$7\",\"$39\",\"$3a\",\"$3b\",\"$3c\",\"$3d\",\"$3e\"],\"default\"]\n81:I[12539,[\"$4\",\"$5\",\"$6\",\"$7\",\"$39\",\"$3a\",\"$3b\",\"$3c\",\"$3d\",\"$3e\"],\"default\"]\n83:I[92749,[\"$4\",\"$5\",\"$6\",\"$7\",\"$39\",\"$3a\",\"$3b\",\"$3c\",\"$3d\",\"$3e\"],\"TeamSummary\"]\n84:I[27,[\"$4\",\"$5\",\"$6\",\"$7\",\"$39\",\"$3a\",\"$3b\",\"$3c\",\"$3d\",\"$3e\"],\"default\"]\n89:I[65314,[\"$4\",\"$5\",\"$6\",\"$7\",\"$39\",\"$3a\",\"$3b\",\"$3c\",\"$3d\",\"$3e\"],\"default\"]\n82:T6e3,\u003cp\u003eWith this mod as well as the BetterEnd Fabric mod installed, the end cities that generate will be much more intricate in design and will include the wood types and some decorations from the BetterEnd mod.\u003c/p\u003e\n\u003cp\u003eThe end cities will also include more loot as each loot room has more chests.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis mod is a perfect addition to any modpack that includes BetterEnd Fabric.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFor compatibility with \"Lootr\", You must download and use this datapack: \u003ca href=\"/linkout?remoteUrl=https%253a%252f%252fwww.planetminecraft.com%252fdata-pack%252flootr-compatibility-pack-for-betterend-fabric%252f\" rel=\"nofollow\"\u003eLootr Compatibility Pack for BetterEnd Fabric Minecraft Data Pack (planetminecraft.com)\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAn example of the cities can be seen below:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://static.planetminecraft.com/files/image/minecraft/data-pack/2022/896/15572481-betterendcitiesthumbnail_l.webp\" alt=\"Example of BetterEnd Better End Cities\" width=\"800\" height=\"506\"\u003e\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAlso try\u0026nbsp;\u003ca href=\"https://legacy.curseforge.com/minecraft/mc-mods/bigger-better-end-cities\" rel=\"nofollow\"\u003eBigger Better End Cities - Mods - Minecraft - CurseForge\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eTo have much bigger cities.\u003c/p\u003e\n\u003cp\u003e\u003cbr\u003eIf a datapack version of this mod is preferable, it can be found here:\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://www.curseforge.com/minecraft/texture-packs/better-end-city-for-better-end\" target=\"_blank\" rel=\"nofollow\"\u003ehttps://www.curseforge.com/minecraft/texture-packs/better-end-city-for-better-end\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFor a version for Vanilla try:\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://curseforge.com/minecraft/mc-mods/better-end-cities-vanilla\" rel=\"nofollow\"\u003eBetter End Cities Vanilla - Mods - Minecraft - CurseForge\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e36:[[\"$\",\"$L7f\",null,{}],\"$L80\",[\"$\",\"$L81\",null,{\"description\":\"$82\",\"showHeader\":false}],[\"$\",\"$L83\",null,{}],[\"$\",\"section\",null,{\"className\":\"shelf\",\"children\":[\"$\",\"div\",null,{\"className\":\"inner\",\"children\":[[\"$\",\"h2\",null,{\"children\":[\"$\",\"span\",null,{\"className\":\" shelf-title-group shelf-title-group-right\",\"children\":[\"More from TheArchitects777\",[\"$\",\"$L84\",null,{\"gameSlug\":\"minecraft\",\"classSlug\":\"$undefined\",\"sortParam\":\"$undefined\",\"viewAllUrl\":\"/members/TheArchitects777\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"content\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mobile-only\",\"children\":[\"$\",\"ul\",null,{\"className\":\"tiles-list\",\"children\":[\"$L85\",\"$L86\",\"$L87\",\"$L88\"]}]}],[\"$\",\"div\",null,{\"className\":\"desktop-only\",\"children\":[\"$\",\"$L89\",null,{\"items\":\"$36:4:props:children:props:children:1:props:children:0:props:children:props:children\"}]}]]}]]}]}]]\n8a:I[63078,[\"$4\",\"$5\",\"$6\",\"